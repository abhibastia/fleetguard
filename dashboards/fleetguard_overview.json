{
  "datasets": [
    {
      "name": "ds_overview_kpis",
      "displayName": "Overview KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM gold_fleet_vehicle) AS fleet_size,\n",
        "  (SELECT COUNT(DISTINCT vin) FROM gold_fleet_exposure) AS vehicles_exposed,\n",
        "  (SELECT COUNT(DISTINCT campaign_number) FROM gold_fleet_exposure) AS open_campaigns,\n",
        "  (SELECT COUNT(DISTINCT campaign_number) FROM gold_fleet_exposure WHERE park_it OR do_not_drive) AS urgent_campaigns"
      ]
    },
    {
      "name": "ds_fleet",
      "displayName": "Fleet roster",
      "queryLines": [
        "SELECT vin, make, model, model_year, segment, depot_id, gvwr_class, body_class, status, manufacture_date ",
        "FROM gold_fleet_vehicle"
      ]
    },
    {
      "name": "ds_exposure",
      "displayName": "Fleet recall exposure",
      "queryLines": [
        "SELECT vin, depot_id, campaign_number, component, make, model, segment, park_it, do_not_drive, match_basis, units_potentially_affected ",
        "FROM gold_fleet_exposure"
      ]
    },
    {
      "name": "ds_top_campaigns",
      "displayName": "Campaigns ranked by consequence then volume",
      "queryLines": [
        "SELECT campaign_number, MIN(component) AS component, BOOL_OR(park_it) AS park_it, BOOL_OR(do_not_drive) AS do_not_drive, ",
        "COUNT(DISTINCT vin) AS vehicles, COUNT(DISTINCT depot_id) AS depots ",
        "FROM gold_fleet_exposure ",
        "GROUP BY campaign_number ",
        "ORDER BY (park_it OR do_not_drive) DESC, vehicles DESC "
      ]
    },
    {
      "name": "ds_signals",
      "displayName": "Emerging defect signals",
      "queryLines": [
        "SELECT series_key, make, model, comp_top, run_start, run_end, run_len, max_z, complaints_in_run, harm_share, fleet_vehicles, is_live, as_of_month ",
        "FROM gold_emerging_signal"
      ]
    },
    {
      "name": "ds_signals_kpis",
      "displayName": "Emerging signals KPIs (pivoted)",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_signals,\n",
        "  SUM(CASE WHEN is_live THEN 1 ELSE 0 END) AS live_signals,\n",
        "  SUM(CASE WHEN fleet_vehicles > 0 THEN 1 ELSE 0 END) AS fleet_signals\n",
        "FROM gold_emerging_signal"
      ]
    },
    {
      "name": "ds_evidence_metrics",
      "displayName": "Evidence metrics (governed)",
      "asset_name": "bootcamp_students.fleetguard.evidence_metrics"
    },
    {
      "name": "ds_trust_recon",
      "displayName": "Bronze -> silver + quarantine reconciliation",
      "queryLines": [
        "WITH recon AS (\n",
        "  SELECT 'complaints (V+T scope)' AS entity,\n",
        "         (SELECT COUNT(*) FROM bronze_complaints WHERE PROD_TYPE IN ('V','T')) AS bronze_n,\n",
        "         (SELECT COUNT(*) FROM silver_complaint) AS silver_n,\n",
        "         (SELECT COUNT(*) FROM silver_complaint_quarantine) AS quarantine_n\n",
        "  UNION ALL\n",
        "  SELECT 'recalls',\n",
        "         (SELECT COUNT(*) FROM bronze_recalls),\n",
        "         (SELECT COUNT(*) FROM silver_recall),\n",
        "         (SELECT COUNT(*) FROM silver_recall_quarantine)\n",
        "  UNION ALL\n",
        "  SELECT 'investigations',\n",
        "         (SELECT COUNT(*) FROM bronze_investigations),\n",
        "         (SELECT COUNT(*) FROM silver_investigation),\n",
        "         (SELECT COUNT(*) FROM silver_investigation_quarantine)\n",
        ")\n",
        "SELECT entity, bronze_n, silver_n, quarantine_n,\n",
        "       CASE WHEN bronze_n = silver_n + quarantine_n THEN 'reconciled' ELSE 'MISMATCH' END AS reconciled\n",
        "FROM recon"
      ],
      "columns": [
        {
          "displayName": "Total Bronze",
          "description": "Total source rows ingested across all three entities",
          "expression": "SUM(`bronze_n`)"
        },
        {
          "displayName": "Total Silver",
          "description": "Rows that passed quality checks",
          "expression": "SUM(`silver_n`)"
        },
        {
          "displayName": "Total Quarantined",
          "description": "Rows routed to quarantine instead of silently dropped",
          "expression": "SUM(`quarantine_n`)"
        },
        {
          "displayName": "Quarantine Rate %",
          "description": "Share of bronze rows quarantined",
          "expression": "SUM(`quarantine_n`) * 100.0 / SUM(`bronze_n`)"
        }
      ]
    },
    {
      "name": "ds_trust_quarantine",
      "displayName": "Quarantine reasons by entity",
      "queryLines": [
        "SELECT 'complaints' AS entity, _dq_failures AS reason, COUNT(*) AS n FROM silver_complaint_quarantine GROUP BY 1,2\n",
        "UNION ALL\n",
        "SELECT 'recalls', _dq_failures, COUNT(*) FROM silver_recall_quarantine GROUP BY 1,2\n",
        "UNION ALL\n",
        "SELECT 'investigations', _dq_failures, COUNT(*) FROM silver_investigation_quarantine GROUP BY 1,2"
      ]
    }
  ],

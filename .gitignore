# Databricks
.databricks/
*.dbc
# Scratch dir for `databricks bundle generate --source-dir`. That command downloads the
# WORKSPACE copy of every notebook next to the YAML it writes, and its default source-dir is
# `src` — which would overwrite the repo with the stale content the bundle exists to remove
# (I-096). It must live inside the repo (the CLI requires a path relative to the bundle root),
# so it is ignored here and deleted after each use.
.dab-scratch/

# Secrets / credentials
*.pem
*.key
.databrickscfg

# Local scratch
/tmp/
*.tmp
.venv/
scratchpad.txt
# Frontend build outputs — regenerated by scripts/build_console.sh
app/frontend/node_modules/
app/frontend/dist/
# NOT ignored: app/backend/fleetguard_api/console/ is committed because the Databricks
# Apps runtime runs no Node — the bundle must ship, not be built on deploy

# TypeScript incremental build cache
*.tsbuildinfo
